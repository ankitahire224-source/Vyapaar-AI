# Vyapaar AI — Environment Configuration Example
# Copy this file to .env or set in Vercel / hosting provider

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google Gemini API Key for Live AI Business Coach
# If not provided, Vyapaar AI automatically uses its grounded intelligent offline advisor engine!
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Application Mode: 'demo' or 'live'
# In demo mode, authentic sample data for "Sharma Chai & Nashta Corner" is pre-loaded.
VITE_APP_MODE=demo
